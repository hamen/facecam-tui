# Elgato Facecam (0fd9:0078) udev rules for facecam-tui. Install to /etc/udev/rules.d/.

# Exposure goes over usbfs: let the logged-in user write the camera's /dev/bus/usb node.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="0078", MODE="0666"

# Keep USB power saving off. After an autosuspend (2 s idle) the camera rejects every control
# request with a stall (EPIPE, "Broken pipe") for about half a second after it wakes up, so any
# tool that talks to a camera that is not streaming fails.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0fd9", ATTR{idProduct}=="0078", TEST=="power/control", ATTR{power/control}="on"

# Mains flicker: the camera can come up set to 60 Hz. Under 50 Hz lights (Europe and most of
# the world outside the Americas) Auto exposure then flickers. Use 2 for 60 Hz countries.
ACTION=="add", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="0078", ATTR{index}=="0", RUN+="/usr/bin/v4l2-ctl -d $devnode -c power_line_frequency=1"
